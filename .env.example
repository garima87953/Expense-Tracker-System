# Flask Configuration
SECRET_KEY=dev-secret-key-expense-tracker-2026-secure
FLASK_ENV=development
PORT=5000

# Database Configuration (MySQL)
# Set USE_MYSQL=true to connect to MySQL, or set DATABASE_URL directly
USE_MYSQL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=expense_tracker

# Or provide full connection string:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/expense_tracker

# AI Insights Configuration (Optional)
# If left empty, built-in intelligent statistical financial heuristic engine will be used
AI_PROVIDER=heuristic
AI_API_KEY=
